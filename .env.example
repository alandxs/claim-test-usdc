# 归集目标地址（默认即题目要求的地址，可改）
TARGET_ADDRESS=Hngd6dHVsmarpmRh3VPtZook7xu1szdysWth8pNKGgnM

# 资助账户私钥（base58 字符串，例如从 Phantom 导出）。该账户需要至少 ~1 SOL Devnet 余额，用于给 100 个临时账户分发 gas。
FUNDER_SECRET_KEY=

# 每个临时账户分发多少 SOL（用于建 ATA + 转账 gas），默认 0.005 已足够
SOL_PER_ACCOUNT=0.005

# 想生成多少个账户（默认 100）
ACCOUNT_COUNT=100

# Solana Devnet RPC（可换成 helius/quicknode 等私有节点提速、避免限速）
SOLANA_RPC_URL=https://api.devnet.solana.com

# Circle Devnet USDC mint（一般无需改动）
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
