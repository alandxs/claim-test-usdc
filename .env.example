# 归集目标地址（默认即题目要求的地址，可改）
TARGET_ADDRESS=Hngd6dHVsmarpmRh3VPtZook7xu1szdysWth8pNKGgnM

# 资助账户私钥（base58 字符串，例如从 Phantom 导出）。该账户需要至少 ~1 SOL Devnet 余额，用于给 100 个临时账户分发 gas。
FUNDER_SECRET_KEY=

# 每个临时账户分发多少 SOL（用于建 ATA + 转账 gas），默认 0.005 已足够
SOL_PER_ACCOUNT=0.005

# 想生成多少个账户（默认 100）
ACCOUNT_COUNT=100

# Solana Devnet RPC（可换成 helius/quicknode 等私有节点提速、避免限速）
SOLANA_RPC_URL=https://api.devnet.solana.com

# Circle Devnet USDC mint（一般无需改动）
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ===== 2Captcha 自动解 reCAPTCHA Enterprise（必填）=====
# 去 https://2captcha.com/ 注册并充值，把 API Key 填这里。
# Circle Faucet 用 reCAPTCHA Enterprise v3 + v2 fallback，全程由 2Captcha 自动解题。
# 100 个账户预算约 $0.6（每账户 ≈ $0.006）
TWOCAPTCHA_API_KEY=

# 单次 2Captcha 解题超时（ms），默认 180000
# TWOCAPTCHA_TIMEOUT_MS=180000

# v3 解题分数下限，0.3-0.9 越高越严格越贵，默认 0.7
# TWOCAPTCHA_V3_MIN_SCORE=0.7

# 单账户最长尝试时间（ms），超时跳过，下次 npm run claim 会自动重试，默认 300000（5 分钟）
# CLAIM_HARD_TIMEOUT_MS=300000

# 卡顿心跳间隔（ms），默认 30000（30s 打印一次当前状态）
# CLAIM_STUCK_RETRIGGER_MS=30000

# 浏览器持久化 profile 路径，默认 .browser-profile
# BROWSER_PROFILE_DIR=.browser-profile
